
from fastapi import FastAPI

# Create FastAPI application
app = FastAPI(
    title="SmartResume API",
    description="AI-powered Resume Parser and Ranker",
    version="1.0.0"
)


# Home route
@app.get("/")
def home():
    return {
        "message": "Welcome to SmartResume!",
        "project": "AI Resume Parser and Ranker",
        "status": "Running Successfully"
    }


# Health check route
@app.get("/health")
def health_check():
    return {
        "status": "healthy",
        "application": "SmartResume"
    }
